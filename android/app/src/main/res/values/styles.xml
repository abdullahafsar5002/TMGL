<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TMGL" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0B0B0E</item>
        <item name="android:navigationBarColor">#0B0B0E</item>
        <item name="android:windowBackground">#0B0B0E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.TMGL.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0B0E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/Theme.TMGL</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
    </style>

    <style name="Theme.TMGL.EdgeToEdge" parent="Theme.TMGL">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
